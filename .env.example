# Copy to `.env` and fill in (`.env` is gitignored). Used by examples/backend.js, examples/wallet.js and examples/widget.js.

# Backend only. Your Rheon sandbox API key (rk_test_...). Never ship it in an app.
RHEON_API_KEY=

# Rheon's sandbox API host. examples/backend.js refuses the production host: it has no user authentication.
RHEON_API_BASE=https://api.sandbox.rheon.io

# Where examples/backend.js listens and the other examples find it. Keep HOST=127.0.0.1: the backend has no user
# authentication, and another HOST (e.g., 0.0.0.0) exposes it to your network.
HOST=127.0.0.1
PORT=8787
BACKEND_URL=http://127.0.0.1:8787

# examples/widget.js and examples/wallet.js keep one-use widget and verification links out of their output.
# Set SHOW_LINK=1 to print them on your own machine.
SHOW_LINK=

# examples/wallet.js: read this existing transaction again (e.g., its verification link) instead of creating one.
TRANSACTION_ID=

# examples/wallet.js and examples/widget.js: the address that receives the test tokens, on the route's chain.
WALLET_ADDRESS=

# examples/wallet.js: the route (optional; default: the account's first token and currency).
CRYPTO_ASSET=
CHAIN=
FIAT_CURRENCY=

# examples/wallet.js: the test user. Rheon refuses native Apple Pay to users in the EEA and the UK.
USER_EMAIL=wdk-example@example.com
USER_IP=8.8.8.8
USER_COUNTRY=US

# examples/widget.js: buy or sell, and the widget method (bank, card, or apple_pay_hosted for buy only).
# Rheon's sandbox widget routes are USDC on base-sepolia with EUR and method bank.
JOURNEY=buy
PAYMENT_METHOD=bank
